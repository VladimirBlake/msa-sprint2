{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "create_booking": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "BookingDb": "Server=booking-db;Port=5432;Database=booking;User Id=booking;Password=booking;"
  },
  "Hotelio": {
    "MonolithBaseUrl": "http://hotelio-monolith:8080",
    "TimeoutSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "create-booking-group"
  }
}
